# AUTHENTICATION
# Secret key used to sign and verify JSON Web Tokens (JWTs).
JWT_SECRET=some-long-random-access-secret

# POSTGRESQL DATABASE
# Address of the PostgreSQL database.
POSTGRES_HOST=127.0.0.1
# Port on which PostgreSQL accepts connections.
POSTGRES_PORT=5432
# PostgreSQL username used by the backend.
POSTGRES_USER=summit_dev
# Password associated with the PostgreSQL user.
POSTGRES_PASSWORD=dev123
# Name of the PostgreSQL database used by summit.
POSTGRES_DB=summit_db

# PUBLIC API CONFIGURATION
# Base URL used by the frontend.
PUBLIC_API_URL=http://localhost:3000

# SERVER CONFIGURATION
# Address the backend server listens on.
SERVER_BIND_ADDRESS=127.0.0.1
# Port on which the backend server listens.
SERVER_PORT=3000

# AI SUMMARIES (OpenRouter)
# Get a key at https://openrouter.ai/keys . Leave it empty to switch AI summaries off.
OPENROUTER_API_KEY=
# Model used to write the summaries. This one is very cheap.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# CLASS DEMO CONFIGURATION
# Configure the application for a class demo.
ENABLE_DEMO_MODE=false
# Toy code for email verification.
DEMO_MODE_CODE=000000
